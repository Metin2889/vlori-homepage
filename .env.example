# Adresse der Floot-App (Login, Registrierung, Projekte). Solange app.vlori.de nicht existiert: die *.floot.app-Adresse eintragen.
NEXT_PUBLIC_APP_URL=https://app.vlori.de
# Endgültige Adresse dieser Website (SEO, Sitemap, Bestätigungslinks)
NEXT_PUBLIC_SITE_URL=https://vlori.de

# Optional – Supabase (Projekt-Alarm, Live-Daten). Ohne diese Werte zeigt die Seite Beispieldaten
# und der Projekt-Alarm leitet zur Registrierung weiter.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional – Bestätigungs-E-Mail (Double-Opt-in) über Resend
RESEND_API_KEY=
ALERT_FROM_EMAIL=vlori <alarm@vlori.de>
